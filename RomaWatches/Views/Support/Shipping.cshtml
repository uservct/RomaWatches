@{
    ViewData["Title"] = "Chính sách vận chuyển - ROMA WATCHES";
    Layout = null;
}
<!DOCTYPE html>
<html class="dark" lang="vi">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif:wght@400;700;900&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />
    <script id="tailwind-config">
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            colors: {
              "primary": "#ecb613",
              "background-light": "#f8f8f6",
              "background-dark": "#221d10",
            },
            fontFamily: {
              "display": ["Noto Serif"]
            },
            borderRadius: {"DEFAULT": "0.25rem", "lg": "0.5rem", "xl": "0.75rem", "full": "9999px"},
          },
        },
      }
    </script>
    <style>
        .material-symbols-outlined {
          font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
    </style>
</head>
<body class="bg-background-light dark:bg-background-dark font-display text-gray-800 dark:text-gray-200">
    <div class="relative flex h-auto min-h-screen w-full flex-col overflow-x-hidden">
        <!-- Header Partial -->
        @await Html.PartialAsync("_Header")
        <div class="h-[72px]"></div>
        
        <div class="layout-container flex h-full grow flex-col">
            <main class="mx-auto flex w-full max-w-4xl flex-1 flex-col px-4 py-10 sm:px-6 lg:px-8">
                <div class="mb-8">
                    <h1 class="text-4xl font-black leading-tight tracking-[-0.033em] text-gray-900 dark:text-white mb-4">Chính sách vận chuyển</h1>
                </div>
                
                <div class="prose prose-lg dark:prose-invert max-w-none text-gray-700 dark:text-gray-300">
                    <div class="markdown markdown-main-panel space-y-6" dir="ltr">
                        <div>
                            <p class="text-xl font-bold text-gray-900 dark:text-white mb-3">1. Phạm vi giao hàng</p>
                            <ul class="list-disc list-inside space-y-2 ml-4">
                                <li>ROMA WATCHES giao hàng toàn quốc</li>
                                <li>Thời gian giao hàng: 1-3 ngày làm việc (tùy khu vực)</li>
                                <li>Giao hàng nhanh: 24 giờ (áp dụng cho khu vực nội thành Hà Nội và TP. Hồ Chí Minh)</li>
                            </ul>
                        </div>
                        
                        <div>
                            <p class="text-xl font-bold text-gray-900 dark:text-white mb-3">2. Phí vận chuyển</p>
                            <ul class="list-disc list-inside space-y-2 ml-4">
                                <li>Miễn phí vận chuyển cho đơn hàng từ 2.000.000 VNĐ trở lên</li>
                                <li>Phí vận chuyển được tính dựa trên khoảng cách và trọng lượng đơn hàng</li>
                                <li>Phí vận chuyển sẽ được hiển thị rõ ràng trong quá trình thanh toán</li>
                            </ul>
                        </div>
                        
                        <div>
                            <p class="text-xl font-bold text-gray-900 dark:text-white mb-3">3. Quy trình giao hàng</p>
                            <ul class="list-disc list-inside space-y-2 ml-4">
                                <li>Sau khi đặt hàng thành công, bạn sẽ nhận được email xác nhận</li>
                                <li>Nhân viên ROMA WATCHES sẽ liên hệ để xác nhận địa chỉ giao hàng</li>
                                <li>Bạn sẽ nhận được thông báo khi đơn hàng đang được vận chuyển</li>
                                <li>Vui lòng kiểm tra hàng hóa trước khi ký nhận</li>
                            </ul>
                        </div>
                        
                        <div>
                            <p class="text-xl font-bold text-gray-900 dark:text-white mb-3">4. Lưu ý</p>
                            <ul class="list-disc list-inside space-y-2 ml-4">
                                <li>Vui lòng cung cấp địa chỉ chính xác và số điện thoại liên hệ</li>
                                <li>Nếu không liên hệ được, đơn hàng sẽ được giao lại vào ngày hôm sau</li>
                                <li>ROMA WATCHES không chịu trách nhiệm nếu địa chỉ giao hàng không chính xác</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </main>
        </div>
        <!-- Footer Partial -->
        @await Html.PartialAsync("_Footer")
    </div>
    
    <!-- Modal Login và Scripts chung -->
    @await Html.PartialAsync("_LoginModal")
    @await Html.PartialAsync("_CommonScripts")
</body>
</html>
